# Standalone probability VLM. No image/video generator is started.
AVIC_TEXT_PROVIDER=local
# Root must contain processor/ and text_encoder/ for the existing Qwen3-VL.
AVIC_TEXT_MODEL_DIR=/absolute/path/to/Qwen-Image-2.1-Turbo
# Optional API provider; local remains the tested default.
# AVIC_TEXT_PROVIDER=glm
# AVIC_GLM_API_KEY=replace_locally
# AVIC_GLM_MODEL=glm-4.6v-flash
