# Copy this file to config/avic.env and replace paths for your machine.
# config/avic.env is ignored by Git and is sourced by the run scripts.

# ApexNav / Habitat / ROS environment.
APEXNAV_CONDA_ENV=apexnav
APEXNAV_CONDA_SETUP=/path/to/miniconda3/etc/profile.d/conda.sh

# Separate Stable Virtual Camera environment and external source checkout.
AVIC_PYTHON=/path/to/miniconda3/envs/avic/bin/python
AVIC_ROOT=/path/to/Adaptive-Visual-Imagination-Control

# Local vLLM executable and Qwen cache. AVIC_VLLM may also be a command on PATH.
AVIC_VLLM=/path/to/vllm
AVIC_QWEN_HF_HOME=/path/to/huggingface/cache
AVIC_QWEN_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# Shared verifier contract. The launcher, service-side frame sampler and
# preflight all derive their image budget from this value.
AVIC_QWEN_MAX_IMAGES_PER_PROMPT=12

# Optional output locations. Defaults stay under ignored repository folders.
# APEXNAV_LOG_ROOT=/path/to/local/logs
# APEXNAV_OUTPUT_ROOT=/path/to/local/results
# AVIC_OUTPUT_ROOT=/path/to/local/avic-artifacts

# Local OpenAI-compatible Qwen server. EMPTY is a non-secret placeholder.
AVIC_VLM_API_KEY=EMPTY
